// Instellingen voor Cloudflare (Workers met statische bestanden).
// Cloudflare voert eerst "node build.js" uit en zet daarna de map "dist" online.
{
  "name": "visualize-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
